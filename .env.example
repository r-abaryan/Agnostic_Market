# Example env for local dev — copy to `.env` and fill in. NEVER commit `.env` (gitignored).
# Secrets resolve via the SecretResolver seam using `env://NAME` refs (SECURITY §5);
# config files hold only the ref (e.g. `secrets_ref: env://ANTHROPIC_API_KEY`), never the value.

# --- LLM providers (Phase 1: agnostic gateway + conformance gate) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
