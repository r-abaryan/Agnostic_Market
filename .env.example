# Example env for local development. Copy to `.env` and fill it in. Never commit `.env`.
# Secrets resolve through the SecretResolver using `env://NAME` references.
# config files hold only the ref (e.g. `secrets_ref: env://ANTHROPIC_API_KEY`), never the value.

# --- LLM providers (Phase 1: agnostic gateway + conformance gate) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Voice providers (Phase 2: minimal voice loop; refs in config/base/providers.yaml) ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# --- LiveKit Cloud (Phase 2: the AgentSession worker; read by the LiveKit SDK directly) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Runtime identity ---
VOICE_AGENT_DEPLOYMENT_ID=
# Required for network worker commands. Console and model-file download do not use it.
VOICE_AGENT_NAME=
# Required only for the local console. Network jobs resolve through trusted admission metadata.
VOICE_AGENT_MERCHANT_ID=

# --- Optional Phase 4C PostgreSQL checkpoint harness ---
# Set at most one option. Leave both blank to use the harness-owned Docker container.
# A supplied DSN receives a unique harness-owned schema for each run.
PHASE4C_POSTGRES_DSN=
# For the Windows binary ZIP, use the extracted `pgsql/bin` directory.
PHASE4C_POSTGRES_BIN=
